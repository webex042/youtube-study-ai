# ═══════════════════════════════════════════════════════════════
# AI Study Lab — Environment Template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every value here is a placeholder — no real secrets in this file.
# ═══════════════════════════════════════════════════════════════

# ── LLM PROVIDER (one key is enough) ────────────────────────────
# If neither is set, the app falls back to a rule-based generator
# and no data leaves your server.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── ENVIRONMENT ─────────────────────────────────────────────────
# development | production | test
APP_ENV=development

# Debug is force-disabled whenever APP_ENV=production.
DEBUG=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── HTTPS & TRANSPORT SECURITY ──────────────────────────────────
# Sends HSTS and upgrade-insecure-requests. Enable only when the app
# is genuinely served over HTTPS. Defaults to true in production.
FORCE_HTTPS=false
HSTS_MAX_AGE=31536000

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated exact origins. Leave EMPTY for same-origin only
# (the default and recommended setting). "*" is ignored by design.
# Example: https://study.example.com,https://www.study.example.com
CORS_ALLOW_ORIGINS=

# ── REVERSE PROXY ───────────────────────────────────────────────
# Set to true ONLY when a trusted proxy (nginx, Cloudflare, ALB) sets
# X-Forwarded-For. If false, that header is ignored so clients cannot
# spoof their IP to bypass rate limits.
TRUST_PROXY_HEADERS=false

# ── RATE LIMITING ───────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# Expensive endpoint (/api/study): requests per window, per client.
STUDY_RATE_LIMIT=5
STUDY_RATE_WINDOW=300

# Longer window to stop slow-drip abuse.
STUDY_DAILY_LIMIT=60
STUDY_DAILY_WINDOW=86400

# Ceiling for all other endpoints.
GLOBAL_RATE_LIMIT=120
GLOBAL_RATE_WINDOW=60

# Process-wide concurrent study generations.
MAX_CONCURRENT_STUDIES=4

# ── REQUEST LIMITS ──────────────────────────────────────────────
MAX_REQUEST_BYTES=4096
MAX_URL_LENGTH=2048

# ── TRANSCRIPT & AI RESOURCE LIMITS ─────────────────────────────
MAX_TRANSCRIPT_CHARS=400000
MAX_TRANSCRIPT_SNIPPETS=20000
CHUNK_MAX_CHARS=10000
MAX_CHUNKS=12
MAX_PROMPT_CHARS=60000
MAX_LLM_RESPONSE_CHARS=400000
MAX_TRANSCRIPT_RESPONSE_CHARS=120000

# ── TIMEOUTS (seconds) ──────────────────────────────────────────
TRANSCRIPT_TIMEOUT=20
LLM_TIMEOUT=60
TOTAL_STUDY_TIMEOUT=240

# ── PRIVACY ─────────────────────────────────────────────────────
# Transcripts are processed in memory and never written to disk.
# Leave false unless you add an explicit retention policy.
PERSIST_TRANSCRIPTS=false

# Whether the transcript text is returned to the browser for in-page
# search. Set false to minimise data sent to the client.
INCLUDE_TRANSCRIPT_IN_RESPONSE=true
