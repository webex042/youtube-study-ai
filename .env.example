# ═══════════════════════════════════════════════════════════════
# AI Study Lab — environment template
#
# Copy to `.env` (same folder) and fill in your key. NEVER commit `.env`.
# Every value below is optional except the API key; the defaults shown
# are what the app uses when a line is missing or blank.
# Restart the server after changing this file.
# ═══════════════════════════════════════════════════════════════

# ── AI PROVIDER ─────────────────────────────────────────────────
# Gemini powers everything: chat, Studio, watching videos, audio overviews,
# web search. Get a key at https://aistudio.google.com/apikey
# (new keys start with "AQ.", older ones with "AIza" — both work).
GEMINI_API_KEY=

# Optional text-only alternative, used only when GEMINI_API_KEY is empty.
# It cannot watch videos, read scanned PDFs/images, speak or search the web.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# With no key at all the app still runs: sources are extracted and readable,
# and AI features show a "not configured" message (nothing is faked).

# ── MODELS ──────────────────────────────────────────────────────
# The first model your key can use wins; the fallbacks are tried in order
# when a model is retired or unavailable to your account.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest,gemini-2.5-flash

# Used when PRO mode is switched on in the header.
GEMINI_PRO_MODEL=gemini-4-argon
GEMINI_PRO_FALLBACK_MODELS=gemini-3.1-pro-preview,gemini-pro-latest,gemini-2.5-pro

# Fast model for small jobs: source guides, notebook summaries, the connection test.
GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# Text-to-speech for Audio and Video Overviews.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-lite-tts,gemini-2.5-flash-preview-tts

# Advanced: send Gemini requests through an API gateway/proxy. Leave blank.
GEMINI_BASE_URL=

# ── VIDEO UNDERSTANDING ─────────────────────────────────────────
# Let Gemini watch videos (frames + audio), not just read captions.
# Set false to save tokens — captions are still used when available.
VIDEO_ANALYSIS=true
# Long videos are analysed in parts of this many minutes (5-180).
VIDEO_SEGMENT_MINUTES=20
# Frames per second sampled from videos (0.1-5). Blank = Gemini default (1).
VIDEO_FPS=
# Allow adding arbitrary public web pages as sources.
ALLOW_WEB_SOURCES=true

# ── STORAGE ─────────────────────────────────────────────────────
# Database, uploaded files and generated audio. Relative paths are
# resolved against the project folder.
DATA_DIR=./data

# ── LIMITS ──────────────────────────────────────────────────────
# Largest file upload (lecture videos can be big), in MB.
MAX_UPLOAD_MB=1024
# Largest JSON request body (chat messages, pasted text, edited notes).
MAX_REQUEST_BYTES=2000000
MAX_URL_LENGTH=2048
MAX_PASTED_CHARS=1000000
# Text kept per source / per transcript.
MAX_SOURCE_CHARS=2000000
MAX_TRANSCRIPT_CHARS=1500000
MAX_TRANSCRIPT_SNIPPETS=60000
# Source text sent with one AI request. Bigger notebooks are searched for
# the most relevant passages instead of being sent whole.
MAX_CONTEXT_CHARS=700000
MAX_LLM_RESPONSE_CHARS=600000

# ── TIMEOUTS (seconds) ──────────────────────────────────────────
TRANSCRIPT_TIMEOUT=30
LLM_TIMEOUT=300
VIDEO_ANALYSIS_TIMEOUT=900
WEB_FETCH_TIMEOUT=20

# ── RATE LIMITING ───────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# AI requests (chat, Studio, adding sources) per client.
AI_RATE_LIMIT=40
AI_RATE_WINDOW=60
AI_DAILY_LIMIT=1500
AI_DAILY_WINDOW=86400
# Everything else (the UI polls while jobs run).
GLOBAL_RATE_LIMIT=900
GLOBAL_RATE_WINDOW=60
# Background jobs (source processing + Studio generation) at once.
MAX_CONCURRENT_JOBS=4

# ── ENVIRONMENT ─────────────────────────────────────────────────
# development | production | test
APP_ENV=development
# Debug is force-disabled whenever APP_ENV=production.
DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── DEPLOYMENT (only if you host it somewhere) ──────────────────
# This is a single-user app with no login: keep it on your own machine
# unless you add authentication in front of it.
# Send HSTS / upgrade-insecure-requests (only when served over HTTPS).
FORCE_HTTPS=false
HSTS_MAX_AGE=31536000
# Comma-separated exact origins; empty = same-origin only (recommended).
CORS_ALLOW_ORIGINS=
# true ONLY behind a trusted proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
